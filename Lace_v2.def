Bootstrap: docker
From: docker.io/mambaorg/micromamba:1.5.8

%files
    # Copy lace source tree into the container
    lace/ /opt/Lace/lace
    setup.py /opt/Lace/setup.py

%post
    # Python 3.13 + minimap2 + core dependencies
    # NOTE: matplotlib intentionally excluded -- unused in pipeline
    micromamba install -y -n base -c conda-forge -c bioconda \
        "python>=3.12" \
        "minimap2>=2.28" \
        "numpy>=1.26" \
        "pandas>=2.2" \
        "networkx>=3.4" \
        tqdm \
        pip \
        && micromamba clean --all --yes

    # Install Lace from local source
    /opt/conda/bin/pip install --no-deps /opt/Lace

%environment
    export PATH="/opt/conda/bin:${PATH}"

%labels
    Author martpali
    Version 2.0.0
    Description Lace 2.0 — minimap2, block-graph, Python 3.13

%help
    Lace 2.0: High-performance SuperTranscript construction.

    Rewrite of Lace 1.14.1 with:
      - minimap2 replacing BLAT (30-100x faster, MIT licence)
      - Block-level splice graph (100-1000x fewer graph nodes)
      - Single-pass DFS cycle breaking (exponential -> O(V+E))
      - In-memory cluster dispatch (eliminates ~376K NFS file ops)
      - Python 3.13 with modern typing and structured logging

    Usage:
        apptainer exec lace_2.0.sif Lace input.fasta clusters.txt \
            --cores 16 -o output/

%test
    python -c "import lace; print(f'Lace {lace.__version__}')"
    minimap2 --version
    Lace --help
